    {
      "id": 141,
      "record": "0x800EF000",
      "text_id": 883,
      "english": "You have been in the red for six months, so the banks have closed your park and declared you bankrupt."
    },
    {
      "id": 175,
      "record": "0x800EF2A8",
      "text_id": 515,
      "english": "Congratulations! Because you attracted enough visitors to reach your goal, you get a Gold Ticket!"
    },
    {
      "id": 176,
      "record": "0x800EF2BC",
      "text_id": 902,
      "english": "Nice work! You made a tidy profit in the last 12 months, enough to meet your goal. The Gold Ticket is yours!"
    },
    {
      "id": 177,
      "record": "0x800EF2D0",
      "text_id": 882,
      "english": "Nicely done. You\u0092ve stayed in business long enough to reach your goal. You win a Gold ticket!"
    },
    {
      "id": 188,
      "record": "0x800EF3AC",
      "text_id": 300,
      "english": "WON GOLD TICKET TUTORIAL"
    },
    {
      "id": 178,
      "record": "0x800EF2E4",
      "text_id": 808,
      "english": "You discovered a hidden award! For providing such thorough security coverage in your park, it is my honor to present you with the Security Award and a Gold Ticket. Congratulations!"
    },
    {
      "id": 179,
      "record": "0x800EF2F8",
      "text_id": 573,
      "english": "Congratulations on discovering a hidden award. Since you\u0092ve upgraded such a large percentage of your rides, I bestow upon you the Upgrade Award and a Gold ticket."
    },
    {
      "id": 180,
      "record": "0x800EF30C",
      "text_id": 537,
      "english": "Congratulations! You\u0092ve found a hidden award. In honor of building a large park full of  beautiful features, I present you with the Aesthetic Award and a Gold Ticket to go with it."
    },
    {
      "id": 181,
      "record": "0x800EF320",
      "text_id": 451,
      "english": "Nice work! You\u0092ve discovered a hidden award. For having seen to it that enough of your shops have litter bins to keep the park tidy, please accept the Green Award and a Gold Ticket as tokens of my esteem."
    },
    {
      "id": 182,
      "record": "0x800EF334",
      "text_id": 979,
      "english": "Nice work! You\u0092ve discovered a hidden award. For having seen to it that your visitors don\u0092t have to walk too far to get onto your rides, please accept the Path Award and a Gold Ticket as tokens of my esteem."
    }
