+/* tinyclaw: log every CPU->VRAM upload as (destination rect, content hash).
+ * The hash is FNV-1a over the halfwords actually landed, so a consumer can match
+ * an archive entry to a VRAM slot WITHOUT any pixels crossing between us.
+ * Needed because 12 texture sheets share 4 VRAM slots, so the binding is dynamic
+ * and a static page->entry map cannot exist. */
+static FILE *tpw_up_fp;
+static void tpw_log_upload(struct psx_gpu *gpu, int x, int y, int w, int h)
+{
+  const char *p;
+  unsigned int hash = 2166136261u;
+  int r, c;
+  if (!tpw_up_fp) {
+    p = getenv("TPW_UPLOADLOG");
+    if (!p) { tpw_up_fp = (FILE *)-1; return; }
+    tpw_up_fp = fopen(p, "w");
+    if (!tpw_up_fp) { tpw_up_fp = (FILE *)-1; return; }
+    fprintf(tpw_up_fp, "# x y w h halfwords fnv1a\n");
+  }
+  if (tpw_up_fp == (FILE *)-1) return;
+  for (r = 0; r < h; r++) {
+    const uint16_t *m = VRAM_MEM_XY(gpu->vram, x, (y + r) & 0x1ff);
+    for (c = 0; c < w; c++) { hash ^= m[c]; hash *= 16777619u; }
+  }
+  fprintf(tpw_up_fp, "%d %d %d %d %d %08x\n", x, y, w, h, w * h, hash);
+  fflush(tpw_up_fp);
+}
