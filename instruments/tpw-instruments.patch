+/* --- TPW: record which CLUT (palette) the game actually selects ---------
+ * Guessing a palette out of VRAM cannot work: one texture page is shared by
+ * many palettes, so any single guess is wrong for almost everything on it.
+ * But every textured primitive carries its CLUT address, so the game tells us
+ * outright. Record each distinct one the first time it is seen. */
+static unsigned int tpw_seen[8192];
+static int tpw_nseen = 0;
+static FILE *tpw_fp = NULL;
+
+extern unsigned long tpw_path_used[3];
+static void tpw_report_paths(void)
+{
+  fprintf(stderr, "[tpw] cmd-list paths carried work: frameskip=%lu async=%lu plain=%lu\n",
+          tpw_path_used[0], tpw_path_used[1], tpw_path_used[2]);
+}
+
+static void tpw_note_clut(unsigned short clut, unsigned short tpage,
+                          int u0, int v0, int u1, int v1)
+{
+  /* One texture page carries MANY sprites, each with its own palette, so a
+   * per-page mapping is wrong for nearly all of it. Key on the sprite's
+   * position inside the page (quantised to 16px) to get a per-sprite map. */
+  unsigned int key = ((unsigned int)clut << 16) ^ ((unsigned int)tpage << 8)
+                   ^ ((unsigned int)u0 << 4) ^ (unsigned int)v0
+                   ^ ((unsigned int)u1 << 12) ^ ((unsigned int)v1 << 20);
+  int i;
+  for (i = 0; i < tpw_nseen; i++)
+    if (tpw_seen[i] == key) return;
+  if (tpw_nseen >= 8192) return;
+  tpw_seen[tpw_nseen++] = key;
+  if (!tpw_fp) {
+    const char *p = getenv("TPW_CLUTLOG");
+    if (!p) return;
+    tpw_fp = fopen(p, "w");
+    if (!tpw_fp) return;
+    fprintf(tpw_fp, "# clut_x clut_y tpage_x tpage_y bpp umin vmin umax vmax\n");
+    atexit(tpw_report_paths);
+  }
+  /* CLUT word: bits0-5 = X/16, bits6-14 = Y. TPAGE: bits0-3 = X/64,
+   * bit4 = Y/256, bits7-8 = colour mode (0=4bpp,1=8bpp,2=15bpp). */
+  fprintf(tpw_fp, "%d %d %d %d %d %d %d %d %d\n",
+          (clut & 0x3f) * 16, (clut >> 6) & 0x1ff,
+          (tpage & 0xf) * 64, ((tpage >> 4) & 1) * 256,
+          (tpage >> 7) & 3, u0, v0, u1, v1);
+  fflush(tpw_fp);
+}
+
+/* TPW: VRAM->VRAM copies (GP0 0x80). A texture page can be RESIDENT in VRAM and
+ * never sampled -- entry 0x10C lands at (768..895, 0..511) and 3000 frames of a
+ * park drew from it zero times. If that region is a staging area feeding the
+ * pages that ARE drawn from, the moves must show up here. Records each distinct
+ * (src, dst, size) once; env var TPW_COPYLOG. */
+static unsigned int tpw_cseen[4096];
+static int tpw_ncseen = 0;
+static FILE *tpw_cfp = NULL;
+static unsigned long tpw_ncopy = 0;
+
+/* which of the three command-list paths actually carried work */
+unsigned long tpw_path_used[3] = {0,0,0};
+
+static void tpw_note_copy(unsigned int sx, unsigned int sy,
+                          unsigned int dx, unsigned int dy,
+                          unsigned int w, unsigned int h)
+{
+  unsigned int key = (sx << 22) ^ (sy << 13) ^ (dx << 4) ^ (dy >> 5)
+                   ^ (w << 17) ^ (h << 9) ^ (dy << 27);
+  int i;
+  tpw_ncopy++;
+  for (i = 0; i < tpw_ncseen; i++)
+    if (tpw_cseen[i] == key) return;
+  if (tpw_ncseen >= 4096) return;
+  tpw_cseen[tpw_ncseen++] = key;
+  if (!tpw_cfp) {
+    const char *p = getenv("TPW_COPYLOG");
+    if (!p) return;
+    tpw_cfp = fopen(p, "w");
+    if (!tpw_cfp) return;
+    fprintf(tpw_cfp, "# nth sx sy dx dy w h\n");
+  }
+  fprintf(tpw_cfp, "%lu %u %u %u %u %u %u\n", tpw_ncopy, sx, sy, dx, dy, w, h);
+  fflush(tpw_cfp);
+}
+
+static void tpw_scan_list(struct psx_gpu *gpu, const uint32_t *list, int count)
+{
+  int pos = 0;
+  /* This scan runs BEFORE the renderer executes the list, so ex_regs[1] still
+   * holds the page from the PREVIOUS list: any texpage set inside this one has
+   * not been applied yet. Sprites then get paired with a stale page (usually
+   * 0), which is what dumped a thousand primitives onto a bogus page(0,0).
+   * So track the page myself as I walk, exactly as the GPU will. */
+  unsigned short cur_tpage = (unsigned short)(gpu->ex_regs[1] & 0xffff);
+  while (pos < count) {
+    int op = list[pos] >> 24;
+    int len = 1 + cmd_lengths[op];
+    if (pos + len > count) break;
+    if (op == 0xe1)
+      cur_tpage = (unsigned short)(list[pos] & 0xffff);
+    /* Bit 2 means "textured" for POLYGONS (0x20-0x3f) and RECTS (0x60-0x7f)
+     * only. 0x40-0x5f are LINES, which carry no texture and no CLUT -- and
+     * including them reads two unrelated words as a clut/texpage pair, which
+     * is what parked a thousand bogus primitives on page(0,0).
+     * CLUT is word 2's high half. TEXPAGE is carried IN the primitive for
+     * polygons (word 4 flat, word 5 gouraud); rects use the latched page. */
+    if (((op >= 0x20 && op < 0x40) || (op >= 0x60 && op < 0x80))
+        && (op & 0x04) && len >= 3) {
+      unsigned short tp;
+      if (op < 0x40) {                 /* polygon: page is IN the primitive */
+        int ti = (op & 0x10) ? 5 : 4;  /* bit4 = gouraud */
+        if (pos + ti < count) {
+          tp = (unsigned short)(list[pos + ti] >> 16);
+          cur_tpage = tp;              /* the GPU latches it too */
+        } else tp = cur_tpage;
+      } else {                         /* sprite/rect: uses the latched page */
+        tp = cur_tpage;
+      }
+      {
+        /* One UV cannot identify a sprite, so take the bounding box over ALL
+         * of the primitive's UVs. Flat polys carry uv at words 2,4,6,8;
+         * gouraud at 2,5,8,11; sprites carry uv at word 2 plus a size word. */
+        int uo[4], n = 0, k, umin = 255, vmin = 255, umax = 0, vmax = 0;
+        if (op < 0x40) {
+          int nv = (op & 0x08) ? 4 : 3;
+          int step = (op & 0x10) ? 3 : 2;
+          for (k = 0; k < nv; k++) uo[n++] = 2 + k * step;
+        } else {
+          uo[n++] = 2;
+        }
+        for (k = 0; k < n; k++) {
+          int u, v;
+          if (pos + uo[k] >= count) break;
+          u = list[pos + uo[k]] & 0xff;
+          v = (list[pos + uo[k]] >> 8) & 0xff;
+          if (u < umin) umin = u;
+          if (u > umax) umax = u;
+          if (v < vmin) vmin = v;
+          if (v > vmax) vmax = v;
+        }
+        if (op >= 0x40 && len >= 4) {   /* textured rect: word 3 is w,h */
+          int ww = list[pos + 3] & 0xffff, hh = (list[pos + 3] >> 16) & 0xffff;
+          if (ww > 0 && ww < 256) umax = umin + ww - 1;
+          if (hh > 0 && hh < 256) vmax = vmin + hh - 1;
+        }
+        if (umin <= umax)
+          tpw_note_clut((unsigned short)(list[pos + 2] >> 16), tp,
+                        umin, vmin, umax, vmax);
+      }
+    }
+    pos += len;
+  }
+}
